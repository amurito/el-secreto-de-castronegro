    "prueba": "tsx src/prueba.ts",
    "prueba:libre": "tsx src/prueba-libre.ts",
    "prueba:cripto": "tsx src/prueba-cripto.ts",
    "prueba:opciones": "tsx src/prueba-opciones.ts",
    "prueba:desenlaces": "tsx src/prueba-desenlaces.ts",
    "prueba:social": "tsx src/prueba-social.ts",
    "prueba:umbral": "tsx src/prueba-umbral.ts",
    "prueba:desarrollo": "tsx src/prueba-desarrollo.ts",
    "prueba:desacople": "tsx src/prueba-desacople.ts",
    "prueba:legua": "tsx src/prueba-legua.ts",
    "prueba:campana": "tsx src/prueba-campana.ts",
    "prueba:creacion": "tsx src/prueba-creacion.ts",
    "prueba:tiradas": "tsx src/prueba-tiradas.ts",
    "prueba:auditoria": "tsx src/prueba-auditoria.ts",
    "revisar:bundle": "tsx src/revisar-bundle.ts",
    "desplegar": "tsx src/desplegar.ts",
    "prueba:todo": "npm run prueba:cripto && npm run prueba && npm run prueba:libre && npm run prueba:opciones && npm run prueba:desenlaces && npm run prueba:social && npm run prueba:umbral && npm run prueba:desarrollo && npm run prueba:desacople && npm run prueba:legua && npm run prueba:campana && npm run prueba:creacion && npm run prueba:tiradas && npm run prueba:auditoria && npm run build && npm run revisar:bundle"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
