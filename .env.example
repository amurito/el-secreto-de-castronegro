# Copiá este archivo a `.env` y poné tu clave.
# SIN clave el juego funciona igual: el Keeper corre en MODO MOTOR (narración
# determinista generada por el propio motor). Con clave, narra Claude.

ANTHROPIC_API_KEY=

# Modelo del Keeper. Opus 5 es el default por los mensajes de sistema
# en medio de la conversación (ver Analisis_Tecnico_v1.1 §4.2).
KEEPER_MODEL=claude-opus-5

# low | medium | high | xhigh | max  — perilla de costo/calidad por turno.
KEEPER_EFFORT=medium

# Puerto de la API. Variable propia a propósito: PORT la pisan demasiadas
# herramientas y el servidor terminaría escuchando donde escucha la interfaz.
CASTRONEGRO_PORT=8787
